<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0B7A3B" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:background="#1A000000" android:padding="14dp" android:layout_marginEnd="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="आज का कुल" android:textColor="#CCFFFFFF" android:textSize="12sp"/>
            <TextView android:id="@+id/todayTotal" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="₹0"
                android:textColor="#FACC15" android:textSize="22sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:background="#1A000000" android:padding="14dp" android:layout_marginStart="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="कुल जमा" android:textColor="#CCFFFFFF" android:textSize="12sp"/>
            <TextView android:id="@+id/allTotal" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="₹0"
                android:textColor="#FACC15" android:textSize="22sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
    <Button android:id="@+id/btnClear" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="🗑️ Clear History"
        android:backgroundTint="#DC2626" android:textColor="#FFFFFF" android:layout_marginBottom="12dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvHistory"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
