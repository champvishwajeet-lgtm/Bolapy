<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B7A3B">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔊 Bolpay" android:textSize="32sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Payment aaye, phone bole!" android:textSize="14sp"
            android:textColor="#CCFFFFFF" android:layout_marginBottom="30dp"/>
        <TextView android:id="@+id/statusTv" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Checking..." android:textSize="16sp"
            android:textColor="#FFFFFF" android:gravity="center" android:padding="20dp"
            android:background="#1A000000" android:layout_marginBottom="20dp"/>
        <Button android:id="@+id/btnPermission" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🔓 Notification Access दें"
            android:textSize="16sp" android:padding="16dp" android:backgroundTint="#FACC15"
            android:textColor="#0B7A3B" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnTest" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🔊 आवाज़ टेस्ट करें"
            android:textSize="16sp" android:padding="16dp" android:backgroundTint="#FFFFFF"
            android:textColor="#0B7A3B" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnHistory" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="📜 Payment History"
            android:textSize="16sp" android:padding="16dp" android:backgroundTint="#FFFFFF"
            android:textColor="#0B7A3B" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnSettings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="⚙️ Settings"
            android:textSize="16sp" android:padding="16dp" android:backgroundTint="#FFFFFF"
            android:textColor="#0B7A3B" android:layout_marginBottom="20dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Setup:\n1. Notification Access ON करें\n2. Bolpay को allow करें\n3. Payment आएगी → phone बोलेगा\n\n⚠️ Ye app payment process नहीं करता।"
            android:textColor="#E0FFFFFF" android:textSize="13sp" android:padding="16dp"
            android:background="#1A000000"/>
    </LinearLayout>
</ScrollView>
