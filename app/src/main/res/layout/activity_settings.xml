<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B7A3B">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚙️ Settings" android:textSize="24sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:layout_marginBottom="20dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="दुकान का नाम" android:textColor="#FFFFFF" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etShopName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="जैसे: शर्मा किराना स्टोर"
            android:background="#FFFFFF" android:padding="12dp" android:layout_marginBottom="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="भाषा" android:textColor="#FFFFFF" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerLang" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="#FFFFFF" android:layout_marginBottom="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="आवाज़ की गति" android:textColor="#FFFFFF" android:layout_marginBottom="6dp"/>
        <SeekBar android:id="@+id/seekSpeed" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="20" android:layout_marginBottom="6dp"/>
        <TextView android:id="@+id/tvSpeedLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Speed: 0.95x"
            android:textColor="#CCFFFFFF" android:layout_marginBottom="20dp"/>
        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="💾 सेव करें"
            android:backgroundTint="#FACC15" android:textColor="#0B7A3B" android:padding="16dp"/>
    </LinearLayout>
</ScrollView>
